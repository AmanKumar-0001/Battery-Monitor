<Window x:Class="BatteryMonitor.Settings.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Monitor — Settings"
        Width="540" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#F9F9F9"
        Foreground="#1F1F1F"
        FontSize="13"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ Settings" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Configure wireless peripherals, alert thresholds, and taskbar visibility."
                       Foreground="#666666" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Devices Card -->
                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Devices &amp; Nicknames" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding DeviceItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding OriginalName}" FontSize="11" Foreground="#888888"/>
                                            <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,4,6,4" Margin="0,2,8,0" FontSize="13"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="Hide in Taskbar"
                                                  IsChecked="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Thresholds Card -->
                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Alert Thresholds" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Low Battery Warning Level (%)" FontWeight="Medium"/>
                                <TextBlock Text="Triggers a notification when battery reaches this percentage (Default: 20%)"
                                           FontSize="11" Foreground="#666666"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="50" Text="{Binding LowBatteryThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Center" VerticalAlignment="Center" Padding="4"/>
                        </Grid>

                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Critical Battery Alert Level (%)" FontWeight="Medium"/>
                                <TextBlock Text="Triggers an urgent warning when battery reaches this percentage (Default: 10%)"
                                           FontSize="11" Foreground="#666666"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="50" Text="{Binding CriticalBatteryThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Center" VerticalAlignment="Center" Padding="4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- General Card -->
                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="General Preferences" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Polling Interval (seconds)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Width="50" Text="{Binding PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Center" VerticalAlignment="Center" Padding="4"/>
                        </Grid>

                        <CheckBox Content="Start Battery Monitor with Windows"
                                  IsChecked="{Binding StartWithWindows, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,8,0,8"/>

                        <CheckBox Content="Enable Demo Mode (Simulate sample peripherals)"
                                  IsChecked="{Binding DemoMode, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,4,0,4"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Width="90" Height="30" Click="OnCloseClicked" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
